@using maximApp.SharedUI.Components.Icons

<div class="h-full flex flex-col">

    <!-- ToolBar - Title -->
    <div class="px-4 py-2 border-b border-slate-200">
        <p class="text-base font-medium text-slate-900">Tool Bar</p>
    </div>

    <!-- ToolBar - 工具選單 -->
    <div class="p-4 border-b border-slate-200">
        <div class="grid grid-cols-3 gap-6">
            <!-- 文字物件工具 -->
            <button class="p-3 hover:bg-slate-100 rounded text-slate-900 shadow-sm">
                <div class="w-8 h-8 [--icon-stroke:1.5]">
                    <TypeIcon />
                </div>
            </button>

            <!-- 條碼物件工具 -->
            <button class="p-3 hover:bg-slate-100 rounded text-slate-900 shadow-sm">
                <div class="w-8 h-8 [--icon-stroke:1.5]">
                    <QRCodeIcon />
                </div>
            </button>

            <!-- 圖片物件工具 -->
            <button class="p-3 hover:bg-slate-100 rounded text-slate-900 shadow-sm">
                <div class="w-8 h-8 [--icon-stroke:1.5]">
                    <ImageIcon />
                </div>
            </button>

            <!-- 線條物件工具 -->
            <button class="p-3 hover:bg-slate-100 rounded text-slate-900 shadow-sm">
                <div class="w-8 h-8 [--icon-stroke:1.5]">
                    <SlashIcon />
                </div>
            </button>

            <!-- 方形物件工具 -->
            <button class="p-3 hover:bg-slate-100 rounded text-slate-900 shadow-sm">
                <div class="w-8 h-8 [--icon-stroke:1.5]">
                    <SquareIcon />
                </div>
            </button>
        </div>
    </div>
    
