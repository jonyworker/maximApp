@page "/controlCenter/access-control"
@layout maximApp.SharedUI.Components.Layouts.ControlCenter.ControlCenterLayout
@using maximApp.SharedUI.Components.Icons
@inject NavigationManager Nav

<h1 class="text-xl font-semibold">Access Control Home.razor</h1>

<div class="bg-white rounded-lg shadow-sm border border-slate-200 flex flex-col h-full">
    <div class="px-6 flex items-center justify-between border-b border-slate-200">
        <!-- Table Header tabs -->
        <div class="flex gap-2">
            <!-- 權限控管 Tab -->
            <button type="button"
                    data-active="@(primaryTab == 0 ? "true" : "false")"
                    @onclick="() => primaryTab = 0"
                    class="w-60 py-6 px-2 font-semibold flex items-center border-b-4 border-transparent gap-2 data-[active=true]:border-slate-900 text-gray-400 data-[active=true]:text-slate-900">
                <div class="w-6 h-6 [--icon-stroke:1.5]">
                    <IdCardLanyardIcon />
                </div>
                <p class="text-xl min-w-0 flex-1 truncate text-left">
                    權限控管
                </p>
            </button>
            <!-- 角色設定 Tab -->
            <button type="button"
                    data-active="@(primaryTab == 1 ? "true" : "false")"
                    @onclick="() => primaryTab = 1"
                    class="w-60 py-6 px-2 font-semibold flex items-center border-b-4 border-transparent gap-2 data-[active=true]:border-slate-900 text-gray-400 data-[active=true]:text-slate-900">
                <div class="w-6 h-6 [--icon-stroke:1.5]">
                    <SmileIcon />
                </div>
                <p class="text-xl min-w-0 flex-1 truncate group-hover:text-slate-900 group-data-[active=true]:text-slate-900 text-left">
                    角色設定
                </p>
            </button>
        </div>
        <!-- Header Buttons -->
        
        <button class="px-6 py-2 border border-slate-900 bg-slate-900 rounded-md text-slate-900 flex items-center text-sm font-medium transition-colors gap-2 shrink-0">
            <div class="w-6 h-6 [--icon-stroke:1.25] text-white">
                <FileUserIcon />
            </div>
            <p class="min-w-0 flex-1 text-white text-left">
                同步使用者
            </p>
        </button>
        
    </div>

    <!-- table body (list) -->
    <div class="flex-1 overflow-auto">
        <table class="w-full text-left border-collapse ">
            <colgroup>
                <col class="w-[320px]" />   <!-- 使用者 -->
                <col class="w-45" />   <!-- 系統管理員 -->
                <col class="w-45" />   <!-- 組員 -->
                <col class="w-45" />   <!-- 組長 -->
                <col class="w-45" />   <!-- 操作 -->
            </colgroup>
            <thead>
                <tr class="bg-white text-xs font-medium text-slate-500 uppercase tracking-wider sticky top-0 shadow-sm">
                    <th class="pl-6 py-3.5">使用者</th>
                    <th class="px-3 py-3.5">系統管理員</th>
                    <th class="px-3 py-3.5">組員</th>
                    <th class="px-3 py-3.5">組長</th>
                    <th class="px-3 py-3.5">操作</th>
                </tr>
            </thead>

            <tbody>
            @foreach (var u in users)
            {
                <tr class="border-b border-slate-200 hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-4 text-slate-800 truncate">
                        <p class="font-medium text-sm">@u.Name</p>
                        <p class="text-xs font-regular text-slate-400">@u.Email</p>
                    </td>

                    @foreach (var role in new[] { "Viewer", "Editor", "Admin" })
                    {
                        <td class="px-3 py-3.5 text-base font-medium text-slate-800">
                            <div class="inline-flex items-center">
                                <label class="flex items-center cursor-pointer relative">
                                    <input type="radio"
                                        name="@($"role-{u.Id}")"
                                        value="@role"
                                        checked="@IsRoleSelected(u.Id, role)"
                                        @onchange="() => SetRole(u.Id, role)"
                                        class="peer h-5 w-5 cursor-pointer transition-all appearance-none rounded
                                                shadow hover:shadow-md border border-slate-300
                                                checked:bg-slate-800 checked:border-slate-800" />

                                    <div class="absolute text-white opacity-0 peer-checked:opacity-100
                                                top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2
                                                pointer-events-none w-3.5 h-3.5 [--icon-stroke:3]">
                                        <CheckIcon />
                                    </div>
                                </label>
                            </div>
                        </td>
                    }

                    <td class="px-3">
                        <button class="p-1 hover:bg-slate-100 rounded-md text-slate-900" type="button">
                            <div class="w-6 h-6 [--icon-stroke:1]">
                                <EyeIcon />
                            </div>
                        </button>
                    </td>
                </tr>
            }
            </tbody>


        </table>
    </div>

    <!-- table footer -->
    <div class="px-6 py-3 border-t border-slate-200 flex items-center justify-between text-sm font-medium text-slate-800">
        <p class="text-slate-500">
        1 of 100 row(s) selected.
        </p>
        <!-- table footer pagination -->
        <div class="flex items-center space-x-8">
            <div class="flex items-center space-x-2">
                <span>Rows per page</span>
                <select class="py-1 pl-2 pr-8 bg-white border border-slate-200 rounded text-sm focus:ring-1 focus:ring-primary outline-none">
                <option>10</option>
                <option>25</option>
                <option>50</option>
                </select>
            </div>
            <span>Page 1 of 10</span>
            <div class="flex items-center space-x-2">
                <button class="p-2 border border-slate-200 rounded-md bg-white text-slate-900">
                    <div class="w-4 h-4">
                        <ChevronsLeftIcon />
                    </div>
                </button>
                <button class="p-2 border border-slate-200 rounded-md bg-white text-slate-900">
                    <div class="w-4 h-4">
                        <ChevronLeftIcon />
                    </div>
                </button>
                <button class="p-2 border border-slate-200 rounded-md bg-white text-slate-900">
                    <div class="w-4 h-4">
                        <ChevronRightIcon />
                    </div>
                </button>
                <button class="p-2 border border-slate-200 rounded-md bg-white text-slate-900">
                    <div class="w-4 h-4">
                        <ChevronsRightIcon />
                    </div>
                </button>
            
            </div>
        </div>
    </div>
</div>


@code {
    // 0 = Draft, 1 = Template
    private int primaryTab = 0;

    private void OpenRow(int id)
    {
        if (primaryTab == 0)
        {
            Nav.NavigateTo($"/draft-editor/{id}");
        }
        else
        {
            Nav.NavigateTo($"/template-preview/{id}");
        }
    }

    private sealed record UserRow(int Id, string Name, string Email);

    private readonly List<UserRow> users = new()
    {
        new(1, "Jack", "jackson.lee@email.com"),
        new(2, "Amy Chen", "amy.chen@email.com"),
        new(3, "Kevin Wu", "kevin.wu@email.com"),
        new(4, "Linda Huang", "linda.huang@email.com"),
        new(5, "Bruce Lin", "bruce.lin@email.com"),
        new(6, "Mia Tsai", "mia.tsai@email.com"),
    };

    // 每個 user 目前選到的職責
    private readonly Dictionary<int, string> roleByUserId = new();

    private void SetRole(int userId, string role)
    {
        roleByUserId[userId] = role;
    }

    private bool IsRoleSelected(int userId, string role)
    {
        return roleByUserId.TryGetValue(userId, out var v) && v == role;
    }
}