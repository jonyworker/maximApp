@inherits LayoutComponentBase
@layout maximApp.SharedUI.Components.Shell.AppShell
@using maximApp.SharedUI.Components.Layouts.LabelEditor
@inject NavigationManager Nav

<CascadingValue Value="IsReadOnly" Name="IsReadOnly">
    <div class="h-full grid grid-rows-[80px_1fr]">
        <!-- Header -->
        <div class="border-b bg-white border-slate-200">
            <EditorHeader />
        </div>

        <!-- Editor Body -->
        <div class="min-h-0 grid grid-cols-[248px_1fr_298px]">
            <aside class="min-h-0 border-r border-slate-200 bg-white">
                <EditorLeftPanel />
            </aside>

            <section class="min-h-0 bg-gray-100 overflow-hidden">
                <EditorCanvas />
            </section>

            <aside class="min-h-0 border-l border-slate-200 bg-white">
                <EditorRightPanel />
            </aside>
        </div>
    </div>
</CascadingValue>

@code {
    private bool IsReadOnly =>
        ("/" + Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/'))
            .StartsWith("template-preview/", StringComparison.OrdinalIgnoreCase);
}
